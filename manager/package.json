{
  "name": "peon-manager",
  "version": "0.22.1",
  "description": "Peon Manager: installiert die Peon-Addons, Modul Peon Broker Client erfasst und wertet Auktionsdaten aus",
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.js",
    "shots": "node test/ui/mock.js > test/ui/mock.json && node test/ui/shots.js test/ui/mock.json test/ui",
    "dist": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist:setup": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "author": "KarloDerBaer",
  "license": "MIT",
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "echarts": "6.1.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "playwright-core": "1.56.0",
    "vite": "8.3.5",
    "vue": "3.5.44"
  },
  "productName": "Peon Manager",
  "private": true,
  "build": {
    "appId": "de.peon.manager",
    "productName": "Peon Manager",
    "executableName": "PeonManager",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "!electron/installer.nsh",
      "src/core/**",
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png",
      "signExecutable": false
    },
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PeonManager-Setup-${version}.${ext}",
      "shortcutName": "Peon Manager",
      "include": "electron/installer.nsh",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/KarloDerBaer/peon/releases/latest/download"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
